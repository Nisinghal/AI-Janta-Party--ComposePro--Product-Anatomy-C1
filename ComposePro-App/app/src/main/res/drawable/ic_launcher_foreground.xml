<?xml version="1.0" encoding="utf-8"?>
<!--
  Compose Pro icon: what the app does, in one glance. Viewfinder corners, the rule-of-thirds grid,
  the subject (white dot) and the spot it should go (green ring with a tick on a grid cross).
  Everything sits inside the 66dp safe zone (21..87) so no launcher mask crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Thirds grid -->
    <path
        android:pathData="M45,31V77M63,31V77M31,45H77M31,63H77"
        android:strokeWidth="1.6"
        android:strokeColor="#66FFFFFF"
        android:strokeLineCap="round" />

    <!-- Viewfinder corners -->
    <path
        android:pathData="M29,39V29H39M69,29H79V39M79,69V79H69M39,79H29V69"
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- The subject, on its way to the spot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,66m-3.5,0a3.5,3.5 0,1 1,7 0a3.5,3.5 0,1 1,-7 0" />
    <path
        android:pathData="M48.5,61.5L53.5,55.5"
        android:strokeWidth="2"
        android:strokeColor="#CCFFFFFF"
        android:strokeLineCap="round" />

    <!-- The spot: green ring with a tick, on the top-right grid cross -->
    <path
        android:fillColor="#1F9D55"
        android:pathData="M63,45m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0" />
    <path
        android:pathData="M58.8,45.2L61.9,48.3L67.4,42.2"
        android:strokeWidth="2.6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
